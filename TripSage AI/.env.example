# TripSage AI Environment Configuration

# App
APP_ENV=development
SECRET_KEY=change-this-to-a-super-secret-jwt-key-for-tripsage-ai-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tripsagedb
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripsagedb
REDIS_URL=redis://localhost:6379/0

# AI Layer
OPENAI_API_KEY=your-openai-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here
MOCK_AI=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
